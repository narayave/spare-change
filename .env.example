# Anthropic API key (console.anthropic.com). Put it in its own workspace with a
# monthly spend limit: that limit is the hard ceiling behind MONTHLY_PASS_CAP.
ANTHROPIC_API_KEY=

# Stripe secret key. Use sk_test_... until you're ready to take real money.
STRIPE_SECRET_KEY=

# Any Postgres. `npm run db` starts an embedded one on this URL for local dev.
DATABASE_URL=postgres://postgres@localhost:5432/postgres

# Passes sold per calendar month. Keep MONTHLY_PASS_CAP x $2.50 at or under your API spend limit.
MONTHLY_PASS_CAP=200

# Public URL, used for Stripe redirects. Defaults to the request's origin.
# APP_URL=https://spare-change.example.com
